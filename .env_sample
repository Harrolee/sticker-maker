IS_LOCAL=true
REPLICATE_API_TOKEN=your-replicate-token
REPLICATE_CARTOONIZE_MODEL_HASH=your-cartoonize-hash
REPLICATE_RM_BACKGROUND_MODEL_HASH=your-rm-bg-hash
SELL_APP_TOKEN=your-sell-app-token
SELL_APP_STOREFRONT_NAME=your-storefront-name
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_HOST=localhost
SMTP_PORT=1025
MJ_APIKEY_PUBLIC=your-mailjet-public
MJ_APIKEY_PRIVATE=your-mailjet-private

# DB settings
# For local dev, IS_LOCAL=true uses hardcoded postgres defaults
# For production (Neon), set IS_LOCAL=false and provide DATABASE_URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin users (comma-separated usernames that can access /admin)
ADMIN_USERS=admin

# Auth mode: 'dev' for local username/password only, 'prod' for OAuth providers
AUTH_MODE=dev

# Google OAuth (required in prod mode)
GOOGLE_OAUTH_API_KEY=your-google-api-key
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (required in prod mode)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Auth0 Configuration (optional - enables Auth0 login when all three are set)
# Get these from your Auth0 Application Settings:
# - Domain: your-tenant.auth0.com (or your custom domain)
# - Client ID and Client Secret: from your Auth0 Regular Web Application
# Make sure to add your callback URL to Allowed Callback URLs in Auth0:
# http://localhost:5001/auth_redirect (for local dev)
# https://yourdomain.com/auth_redirect (for production)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
